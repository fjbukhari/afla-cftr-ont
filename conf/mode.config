// AFLA CFTR Nanopore workflow: overrides the germline defaults in nextflow.config.
params {
    mode = "germline"
    platform = "ont"
    amplicon = true
    bed_padding = 25
    output_format = "bam"
    min_qual = 20
    report_min_depth = 20          // target bases below this depth are flagged as gaps in the report
    cnv_min_depth = 30
    ont_caller = "bcftools"        // bcftools (small image) or clair3 (larger image, about 1 GB)
    bcftools_profile = "ont-sup-1.20"
    clair3_model = "r1041_e82_400bps_sup_v500"
    run_phasing = false            // read-based cis/trans with WhatsHap
    cftr2_list = null              // CFTR2 variant list (.xlsx, from cftr2.org)
}
manifest {
    name = "afla-cftr-ont"
    description = "CFTR analysis of targeted Nanopore (R10.4.1) data: small variants with phasing, poly-T/TG, exon copy number and a one-page report with CFTR2 and ClinVar classes. Not for clinical use."
}
