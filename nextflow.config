// AFLA germline workflow (Illumina short reads) for EPI2ME Desktop.
// Education and research use only, not for clinical use.

params {
    // input: give exactly one of fastq / bam / vcf (this also sets where the workflow starts)
    fastq = null
    bam = null
    vcf = null
    sample_name = null

    // reference and targets
    ref = null
    bed = null
    primer_bed = null
    bed_padding = 100
    auto_targets_min_depth = 20
    build_bwa_index = false

    // steps
    amplicon = false
    run_fastp = true
    mark_duplicates = true
    run_coverage = true
    run_calling = true
    caller = "gatk"
    deepvariant_model = "WES"
    deepvariant_version = "1.9.0"
    use_gpu = true
    run_annotation = true
    run_report = true

    // variant quality filter (soft filter: failing calls are kept but labelled LowQual)
    min_qual = 30
    min_dp = 10
    min_gq = 20

    // annotation (Ensembl VEP offline cache + optional extra sources)
    vep_cache = null
    vep_cache_version = 115
    vep_fasta = null
    vep_plugins_dir = null
    clinvar_vcf = null
    revel_file = null
    alphamissense_file = null

    // somatic mode (AFLA somatic workflow): GATK Mutect2
    normal_sample = null
    min_vaf = 0.02
    min_alt_reads = 5
    mutect2_shards = 1
    germline_resource = null
    panel_of_normals = null
    run_flt3_itd = true     // somatic mode, from FASTQ or BAM: ScanITD on the FLT3 target regions
    itd_min_vaf = 0.01
    run_hotspots = true     // somatic mode: read-level check of key hotspots, shown in the report even below calling limits
    hotspots = "${projectDir}/assets/myeloid_hotspots.tsv"

    // report defaults (all adjustable inside the report)
    report_name = "afla-report.html"
    report_max_pop_af = 0.01
    report_min_vaf = 0.2
    report_min_depth = 20          // clinical report: target bases below this depth are listed as not adequately covered
    recurrence_min_samples = 3     // rare variant passing in >= this many samples of a run (and >= 30% of them): "recurrent in run"
    artefact_list = null           // lab list of known artefacts: tab-separated chrom, pos, ref, alt, note
    report_lab = ""
    report_test = null             // e.g. "Twist Myeloid Profiler DNA panel (67 genes)"; default: the target file name
    // clinical knowledge shown in the report (labels and evidence only; nothing is filtered by it)
    civic_dir = null
    acmg_sf = "${projectDir}/assets/acmg_sf_v3.3.tsv"               // ACMG secondary findings genes
    predisposition_genes = "${projectDir}/assets/germline_predisposition_heme.tsv"

    // output and resources
    out_dir = "output"
    output_format = "cram"
    threads = 12

    help = false
    version = false
    disable_ping = true
}

manifest {
    name = "afla-cftr"
    author = "AFLA project"
    description = "Germline small-variant analysis of Illumina short reads (panels and exomes) with a teaching report. Not for clinical use."
    mainScript = "main.nf"
    nextflowVersion = ">=23.04.0"
    version = "0.1.0"
}

process {
    shell = ["/bin/bash", "-euo", "pipefail"]
    cpus = 2
    memory = "4 GB"
    withLabel: "big" {
        cpus = { params.threads }
        memory = "24 GB"
    }
    withName: "BWA_INDEX" {
        memory = "8 GB"
    }
    withLabel: "gpu" {
        containerOptions = { params.use_gpu.toString() == "true" ? "--gpus all" : "" }
    }
}

executor {
    cpus = params.threads
    memory = "44 GB"
}

profiles {
    // "standard" is the profile EPI2ME Desktop uses
    standard {
        docker {
            enabled = true
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
    }
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/timeline.html"
}
report {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/report.html"
}
trace {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/trace.txt"
}

// germline by default; the somatic workflow copy overrides this
includeConfig "conf/mode.config"
